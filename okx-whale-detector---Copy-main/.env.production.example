# Copy to .env.production on the VPS. Never commit the real file.
# Generate a URL-safe database password, for example: openssl rand -hex 24

POSTGRES_USER=paperapp
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=research
DATABASE_URL=postgresql://paperapp:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@database:5432/research

# Host-side persistent paper data directory. Back this directory up.
PLATFORM_DATA_DIR=/opt/okx-whale-detector/data
PLATFORM_UID=1000
PLATFORM_GID=1000
DASHBOARD_PORT=4173
PAPER_STARTING_EQUITY=10000
PAPER_CHECKPOINT_INTERVAL_MS=5000
PLATFORM_HEALTH_CHECK_INTERVAL_MS=30000

# Deployment traceability. Set these during each deployment.
APP_GIT_COMMIT=REPLACE_WITH_GIT_COMMIT
APP_IMAGE_VERSION=phase12-REPLACE_WITH_SHORT_SHA
APP_CONFIGURATION_VERSION=phase12-v1
PLATFORM_IMAGE_NAME=okx-whale-detector

# Optional notifications. Leave unset if unused.
# DISCORD_WEBHOOK_URL=
# TRADING_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# EMAIL_RELAY_URL=
# EMAIL_RECIPIENT=

# The Phase 12 production profile intentionally needs no OKX trading credentials.
# Public OKX market-data REST/WebSocket endpoints are used for paper/shadow trading.
