{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],

    "rootDir": "./src",
    "outDir": "./dist",

    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/experimental/**/*"]
}
